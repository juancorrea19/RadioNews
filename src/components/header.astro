---
const logoSrc = '/logo-radio-news.png';

const dropdownLinks = [
  { href: '/#flash-informativo', label: 'Flash Informativo' },
  { href: '/#ultima-hora', label: 'Última hora' },
  { href: '/#lo-ultimo', label: 'Lo último' },
  { href: '/#judicial', label: 'Judicial' },
  { href: '/#actualidad', label: 'Actualidad' },
  { href: '/#internacional', label: 'Internacional' },
  { href: '/#nacion', label: 'Nación' },
  { href: '/#deportes', label: 'Deportes' },
  { href: '/#entretenimiento', label: 'Entretenimiento' },
  { href: '/#magazine-cultural', label: 'Magazine Cultural' },
];

const now = new Date();
const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
const currentDate = `${meses[now.getMonth()]}.${now.getDate()}-${now.getFullYear()}`;
---

<header class="sticky top-0 z-50 w-full rounded-b-[20px] bg-smoke shadow-lg">
  <div class="mx-auto w-full max-w-[1440px] px-4 py-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[auto_1fr_auto] lg:items-center lg:gap-8">
      <div class="flex items-center justify-between gap-4 lg:justify-start">
        <a href="/" aria-label="Ir al inicio de Radio News Online">
          <img
            src={logoSrc}
            alt="Radio News Online Logo"
            class="h-20 w-20 cursor-pointer rounded-full object-cover shadow-md ring-2 ring-[#e30713]/20 transition-opacity hover:opacity-90 sm:h-24 sm:w-24 lg:h-[100px] lg:w-[100px]"
          />
        </a>

        <div class="relative">
          <button
            id="header-menu-button"
            type="button"
            class="flex h-12 w-12 items-center justify-center cursor-pointer rounded-full border border-[#1a2332] bg-white/90 shadow-md transition-all hover:bg-white focus:outline-none focus:ring-2 focus:ring-[#e30713]/30"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="header-dropdown-menu"
          >
            <span class="sr-only">Abrir menu de categorias</span>
            <svg width="28" height="20" viewBox="0 0 41 27" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect y="0" width="41" height="3" rx="1.5" fill="#1a2332"></rect>
              <rect y="12" width="41" height="3" rx="1.5" fill="#1a2332"></rect>
              <rect y="24" width="41" height="3" rx="1.5" fill="#1a2332"></rect>
            </svg>
          </button>

          <div
            id="header-dropdown-menu"
            class="invisible absolute right-0 top-14 z-50 flex w-[min(240px,calc(100vw-2rem))] origin-top-right scale-95 flex-col rounded-lg bg-white py-2 opacity-0 shadow-2xl transition duration-150 ease-out lg:left-0 lg:right-auto lg:w-auto lg:min-w-[240px] lg:origin-top-left"
          >
            {dropdownLinks.map((link) => (
              <a
                href={link.href}
                class="px-5 py-2.5 text-base font-semibold text-[#1a2332] transition-colors hover:bg-[#e30713] hover:text-white"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="flex flex-col items-center gap-3">
        <div class="flex flex-col items-center gap-1">
          <h1 class="text-center font-newsreader text-2xl font-semibold tracking-wide text-[#1a2332] sm:text-3xl lg:text-[36px]">
            RADIO NEWS ONLINE
          </h1>
          <div class="h-px w-full max-w-[400px] bg-[#1a2332]"></div>
        </div>

      </div>
      <div class="flex items-center justify-center gap-3 lg:justify-end">
        <button
          type="button"
          data-open-modal="denuncia-modal"
          class="btn-brand group h-10 px-4 font-newsreader text-sm cursor-pointer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span class="hidden sm:inline">Denuncia aqui</span>
          <span class="sm:hidden">Denunciar</span>
        </button>

        <button
          type="button"
          data-open-modal="registro-modal"
          class="flex h-10 items-center gap-2 rounded-full border-2 border-[#1a2332] bg-transparent px-4 font-newsreader text-sm font-bold text-[#1a2332] transition-all hover:bg-[#1a2332] hover:text-white active:scale-95 cursor-pointer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
          </svg>
          Registrarse
        </button>
      </div>
    </div>
  </div>
</header>

<div id="denuncia-modal" data-modal-root class="fixed inset-0 z-[120] hidden items-end justify-center overflow-y-auto overscroll-contain bg-[#041d3d]/70 p-3 backdrop-blur-sm sm:items-center sm:p-4">
  <div data-modal-backdrop class="fixed inset-0"></div>
  <div class="relative z-10 my-auto flex max-h-[min(92dvh,900px)] w-full max-w-lg flex-col overflow-hidden rounded-[24px] border border-white/10 bg-[#f2f2f2] text-[#1a2332] shadow-[0_30px_80px_rgba(0,0,0,0.35)] sm:max-w-xl sm:rounded-[28px]">
    <div class="shrink-0 border-b border-slate-200 bg-[linear-gradient(135deg,#ffffff,#f8ecec)] px-4 py-4 sm:px-6 sm:py-5">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <span class="tag-brand rounded-full px-3 py-1 text-[10px] uppercase tracking-[0.18em]">Radio News Online</span>
          <h2 class="mt-3 font-newsreader text-2xl leading-tight text-[#1a2332] sm:text-3xl">Registrar denuncia</h2>
          <p class="mt-2 font-newsreader text-sm font-medium leading-relaxed text-[#1a2332]/90 sm:text-base">
            Cuéntanos qué ocurrió y cómo contactarte. Si tienes pruebas, adjúntalas. Recibirás confirmación en tu correo.
          </p>
        </div>
        <button type="button" data-close-modal class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-500 transition hover:border-[#e30713] hover:text-[#e30713] sm:h-10 sm:w-10">x</button>
      </div>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-4 sm:px-6 sm:py-5">
      <form data-async-form data-success-message="Tu denuncia fue enviada correctamente." action="/api/denuncias" method="POST" class="space-y-4" id="denuncia-form">
        <input type="hidden" name="evidencePath" id="denunciaEvidencePath" value="" />
        <input type="hidden" name="evidenceFilename" id="denunciaEvidenceFilename" value="" />
        <input type="hidden" name="evidenceMime" id="denunciaEvidenceMime" value="" />
        <input type="hidden" name="evidenceSize" id="denunciaEvidenceSize" value="" />

        <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Nombre completo</span>
            <input class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#e30713] focus:ring-2 focus:ring-[#e30713]/15" type="text" name="nombre" required />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Número de contacto</span>
            <input class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#e30713] focus:ring-2 focus:ring-[#e30713]/15" type="tel" name="numero" required />
          </label>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Correo electrónico</span>
            <input class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#e30713] focus:ring-2 focus:ring-[#e30713]/15" type="email" name="correo" required />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Ubicación</span>
            <input class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#e30713] focus:ring-2 focus:ring-[#e30713]/15" type="text" name="ubicacion" required />
          </label>
        </div>

        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Descripción de la denuncia</span>
          <textarea class="min-h-24 max-h-40 w-full resize-y rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#e30713] focus:ring-2 focus:ring-[#e30713]/15" name="descripcion" required placeholder="Resume lo ocurrido, fechas, nombres o datos que ayuden a validar el caso."></textarea>
        </label>

        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Evidencia</span>
          <div class="rounded-xl border border-dashed border-slate-400 bg-white px-3.5 py-3">
            <input class="block w-full text-sm font-medium text-[#1a2332] file:mr-3 file:rounded-full file:border-0 file:bg-red-brand file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-red-brand-dark" type="file" id="denunciaEvidenceInput" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.mp4,.mp3" />
            <p class="mt-2 text-xs font-medium leading-5 text-slate-700 sm:text-sm">Fotos, documentos, audio o video (máx. 8 MB).</p>
            <p id="denuncia-upload-status" class="mt-2 hidden text-sm text-slate-600"></p>
          </div>
        </label>

        <label class="flex items-start gap-3 rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-sm font-medium leading-relaxed text-[#1a2332]">
          <input type="checkbox" name="autorizaContacto" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#e30713]" />
          <span>Autorizo a Radio News Online a contactarme para ampliar esta información si hace falta.</span>
        </label>

        <div data-form-feedback class="hidden rounded-xl px-4 py-3 text-sm"></div>

        <div class="sticky bottom-0 -mx-4 flex flex-col-reverse gap-2 border-t border-slate-200 bg-[#f2f2f2] px-4 pt-3 sm:-mx-6 sm:flex-row sm:justify-end sm:px-6">
          <button type="button" data-close-modal class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-600 transition hover:border-slate-400 hover:text-slate-900">Cancelar</button>
          <button type="submit" class="btn-brand px-5 py-2.5 text-sm">Enviar denuncia</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="registro-modal" data-modal-root class="fixed inset-0 z-[120] hidden items-end justify-center overflow-y-auto overscroll-contain bg-[#041d3d]/70 p-3 backdrop-blur-sm sm:items-center sm:p-4">
  <div data-modal-backdrop class="fixed inset-0"></div>
  <div class="relative z-10 my-auto flex max-h-[min(92dvh,900px)] w-full max-w-lg flex-col overflow-hidden rounded-[24px] border border-white/10 bg-[#f2f2f2] text-[#1a2332] shadow-[0_30px_80px_rgba(0,0,0,0.35)] sm:max-w-xl sm:rounded-[28px]">
    <div class="shrink-0 border-b border-slate-200 bg-[linear-gradient(135deg,#ffffff,#eef2f9)] px-4 py-4 sm:px-6 sm:py-5">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <span class="rounded-full bg-[#1a2332] px-3 py-1 text-[10px] uppercase tracking-[0.18em] text-white">Radio News Online</span>
          <h2 class="mt-3 font-newsreader text-2xl leading-tight text-[#1a2332] sm:text-3xl">Registro de colaboradores</h2>
          <p class="mt-2 font-newsreader text-sm font-medium leading-relaxed text-[#1a2332]/90 sm:text-base">
            Completa tus datos y cómo te gustaría colaborar. Recibirás confirmación por correo.
          </p>
        </div>
        <button type="button" data-close-modal class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-500 transition hover:border-[#1a2332] hover:text-[#1a2332] sm:h-10 sm:w-10">x</button>
      </div>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-4 sm:px-6 sm:py-5">
      <form data-async-form data-success-message="Tu registro fue enviado correctamente." action="/api/registros" method="POST" class="space-y-4">
        <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Nombre completo</span>
            <input class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#1a2332] focus:ring-2 focus:ring-[#1a2332]/15" type="text" name="nombre" required />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Correo electrónico</span>
            <input class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#1a2332] focus:ring-2 focus:ring-[#1a2332]/15" type="email" name="correo" required />
          </label>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Teléfono</span>
            <input class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#1a2332] focus:ring-2 focus:ring-[#1a2332]/15" type="tel" name="telefono" required />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Ciudad o ubicación</span>
            <input class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#1a2332] focus:ring-2 focus:ring-[#1a2332]/15" type="text" name="ubicacion" required />
          </label>
        </div>

        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Cómo deseas colaborar</span>
          <select class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] outline-none transition focus:border-[#1a2332] focus:ring-2 focus:ring-[#1a2332]/15" name="interes" required>
            <option value="lector">Quiero recibir información</option>
            <option value="fuente">Puedo compartir denuncias o datos</option>
            <option value="publicidad">Me interesa pautar publicidad</option>
            <option value="alianza">Quiero explorar una alianza</option>
          </select>
        </label>

        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#1a2332]">Mensaje adicional</span>
          <textarea class="min-h-20 max-h-36 w-full resize-y rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-base text-[#1a2332] placeholder:text-slate-500 outline-none transition focus:border-[#1a2332] focus:ring-2 focus:ring-[#1a2332]/15" name="mensaje" placeholder="Cuéntanos brevemente cómo te gustaría colaborar."></textarea>
        </label>

        <label class="flex items-start gap-3 rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-sm font-medium leading-relaxed text-[#1a2332]">
          <input type="checkbox" name="autorizaCorreo" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#1a2332]" />
          <span>Acepto ser contactado por correo para novedades, propuestas o seguimiento.</span>
        </label>

        <div data-form-feedback class="hidden rounded-xl px-4 py-3 text-sm"></div>

        <div class="sticky bottom-0 -mx-4 flex flex-col-reverse gap-2 border-t border-slate-200 bg-[#f2f2f2] px-4 pt-3 sm:-mx-6 sm:flex-row sm:justify-end sm:px-6">
          <button type="button" data-close-modal class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-600 transition hover:border-slate-400 hover:text-slate-900">Cancelar</button>
          <button type="submit" class="rounded-full bg-[#1a2332] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#102033]">Enviar registro</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    if (window.__radioNewsHeaderInitialized) return;
    window.__radioNewsHeaderInitialized = true;

    const initHeaderInteractions = () => {
      const button = document.getElementById('header-menu-button');
      const menu = document.getElementById('header-dropdown-menu');

      if (button instanceof HTMLButtonElement && menu instanceof HTMLDivElement) {
        let closeTimer;

        const openMenu = () => {
          if (closeTimer !== undefined) {
            window.clearTimeout(closeTimer);
            closeTimer = undefined;
          }

          menu.classList.remove('invisible', 'scale-95', 'opacity-0');
          menu.classList.add('visible', 'scale-100', 'opacity-100');
          button.setAttribute('aria-expanded', 'true');
        };

        const closeMenu = () => {
          menu.classList.remove('visible', 'scale-100', 'opacity-100');
          menu.classList.add('invisible', 'scale-95', 'opacity-0');
          button.setAttribute('aria-expanded', 'false');
        };

        const scheduleClose = () => {
          closeTimer = window.setTimeout(closeMenu, 120);
        };

        button.addEventListener('click', () => {
          const expanded = button.getAttribute('aria-expanded') === 'true';
          if (expanded) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        button.addEventListener('mouseenter', openMenu);
        button.addEventListener('focus', openMenu);
        button.addEventListener('mouseleave', scheduleClose);
        menu.addEventListener('mouseenter', openMenu);
        menu.addEventListener('mouseleave', scheduleClose);

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Node)) return;
          if (!menu.contains(target) && !button.contains(target)) {
            closeMenu();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeMenu();
            button.blur();
          }
        });
      }

      const modalRoots = Array.from(document.querySelectorAll('[data-modal-root]'));
      const openButtons = Array.from(document.querySelectorAll('[data-open-modal]'));
      const closeButtons = Array.from(document.querySelectorAll('[data-close-modal]'));
      const forms = Array.from(document.querySelectorAll('[data-async-form]'));

      const openModal = (modalId) => {
        const modal = document.getElementById(modalId);
        if (!(modal instanceof HTMLDivElement)) return;

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      };

      const closeModal = (modal) => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        document.body.style.overflow = '';

        const feedback = modal.querySelector('[data-form-feedback]');
        if (feedback instanceof HTMLDivElement) {
          feedback.className = 'hidden rounded-2xl px-4 py-3 text-sm';
          feedback.textContent = '';
        }
      };

      openButtons.forEach((buttonEl) => {
        if (!(buttonEl instanceof HTMLButtonElement)) return;

        buttonEl.addEventListener('click', () => {
          const modalId = buttonEl.dataset.openModal;
          if (modalId) {
            openModal(modalId);
          }
        });
      });

      closeButtons.forEach((buttonEl) => {
        if (!(buttonEl instanceof HTMLButtonElement)) return;

        buttonEl.addEventListener('click', () => {
          const modal = buttonEl.closest('[data-modal-root]');
          if (modal instanceof HTMLDivElement) {
            closeModal(modal);
          }
        });
      });

      modalRoots.forEach((modal) => {
        if (!(modal instanceof HTMLDivElement)) return;

        const backdrop = modal.querySelector('[data-modal-backdrop]');
        if (backdrop instanceof HTMLDivElement) {
          backdrop.addEventListener('click', () => closeModal(modal));
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        modalRoots.forEach((modal) => {
          if (modal instanceof HTMLDivElement && !modal.classList.contains('hidden')) {
            closeModal(modal);
          }
        });
      });

      forms.forEach((formEl) => {
        if (!(formEl instanceof HTMLFormElement)) return;

        formEl.addEventListener('submit', async (event) => {
          event.preventDefault();

          const submitButton = formEl.querySelector('button[type="submit"]');
          const feedback = formEl.querySelector('[data-form-feedback]');
          const modal = formEl.closest('[data-modal-root]');
          const successMessage = formEl.dataset.successMessage || 'Formulario enviado correctamente.';

          if (!(submitButton instanceof HTMLButtonElement) || !(feedback instanceof HTMLDivElement)) {
            return;
          }

          submitButton.disabled = true;
          const originalText = submitButton.textContent;
          submitButton.textContent = 'Enviando...';
          feedback.className = 'hidden rounded-2xl px-4 py-3 text-sm';
          feedback.textContent = '';

          try {
            const response = await fetch(formEl.action, {
              method: 'POST',
              body: new FormData(formEl),
            });

            const payload = await response.json().catch(() => ({}));

            if (!response.ok) {
              throw new Error(payload.message || 'No se pudo enviar el formulario.');
            }

            feedback.className = 'rounded-2xl bg-emerald-50 px-4 py-3 text-sm text-emerald-700';
            feedback.textContent = payload.message || successMessage;
            formEl.reset();

            if (modal instanceof HTMLDivElement) {
              window.setTimeout(() => closeModal(modal), 1200);
            }
          } catch (error) {
            feedback.className = 'rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700';
            feedback.textContent = error instanceof Error ? error.message : 'Ocurrio un error inesperado.';
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = originalText;
          }
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeaderInteractions, { once: true });
      return;
    }

    initHeaderInteractions();
  })();
</script>

<script>
  import { directUpload, formatUploadLabel } from "../scripts/direct-upload";

  const fileInput = document.getElementById("denunciaEvidenceInput");
  const pathInput = document.getElementById("denunciaEvidencePath");
  const filenameInput = document.getElementById("denunciaEvidenceFilename");
  const mimeInput = document.getElementById("denunciaEvidenceMime");
  const sizeInput = document.getElementById("denunciaEvidenceSize");
  const statusEl = document.getElementById("denuncia-upload-status");

  function setStatus(message: string, isError = false) {
    if (!(statusEl instanceof HTMLElement)) return;
    statusEl.classList.toggle("hidden", !message);
    statusEl.classList.toggle("text-red-700", isError);
    statusEl.classList.toggle("text-emerald-700", !isError && Boolean(message));
    statusEl.textContent = message;
  }

  if (
    fileInput instanceof HTMLInputElement &&
    pathInput instanceof HTMLInputElement &&
    filenameInput instanceof HTMLInputElement &&
    mimeInput instanceof HTMLInputElement &&
    sizeInput instanceof HTMLInputElement
  ) {
    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (!file) {
        pathInput.value = "";
        filenameInput.value = "";
        mimeInput.value = "";
        sizeInput.value = "";
        setStatus("");
        return;
      }

      const form = fileInput.closest("form");
      const submit = form?.querySelector('button[type="submit"]');

      void (async () => {
        try {
          if (submit instanceof HTMLButtonElement) submit.disabled = true;
          setStatus(formatUploadLabel("denuncia-evidence", 0));

          const uploaded = await directUpload("denuncia-evidence", file, {
            onProgress: (percent) => setStatus(formatUploadLabel("denuncia-evidence", percent)),
          });

          pathInput.value = uploaded.path;
          filenameInput.value = uploaded.filename;
          mimeInput.value = uploaded.contentType;
          sizeInput.value = String(uploaded.sizeBytes);
          setStatus("Evidencia lista para enviar.");
        } catch (error) {
          fileInput.value = "";
          pathInput.value = "";
          filenameInput.value = "";
          mimeInput.value = "";
          sizeInput.value = "";
          setStatus(error instanceof Error ? error.message : "No se pudo subir la evidencia.", true);
        } finally {
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
        }
      })();
    });
  }
</script>
