---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAuthenticatedAdmin } from "../../../lib/server/admin-auth";
import { isSupabaseConfigured } from "../../../lib/server/supabase";

const session = await getAuthenticatedAdmin(Astro.cookies);

if (!session.user) {
  return Astro.redirect("/admin/login");
}

if (!isSupabaseConfigured()) {
  return Astro.redirect("/admin/login?error=config");
}

const errorRaw = Astro.url.searchParams.get("error");
const error = errorRaw ? decodeURIComponent(errorRaw.replace(/\+/g, " ")) : "";
---

<AdminLayout title="Nueva diapositiva — Flash" userEmail={session.user.email ?? undefined}>
  <section class="rounded-[28px] border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
    {error ? (
      <div class="mb-6 rounded-2xl border border-red-400/25 bg-red-400/10 p-4 text-sm text-red-100">{error}</div>
    ) : null}

    <form method="POST" action="/api/admin/flash/save" class="grid gap-6 lg:grid-cols-2" id="flash-save-form">
      <input type="hidden" name="existingImageUrl" id="flashExistingImageUrl" value="" />
      <input type="hidden" name="existingImagePath" id="flashExistingImagePath" value="" />
      <input type="hidden" name="obsoleteImagePath" id="flashObsoleteImagePath" value="" />

      <label class="block">
        <span class="mb-2 block text-sm text-white/75">Categoria (etiqueta)</span>
        <input
          type="text"
          name="category"
          required
          placeholder="Ej. Nación, Deportes"
          class="w-full rounded-2xl border border-white/10 bg-[#071a34] px-4 py-3 text-white outline-none focus:border-[#e30713]"
        />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm text-white/75">Orden (menor = primero)</span>
        <input
          type="number"
          name="sortOrder"
          value="0"
          class="w-full rounded-2xl border border-white/10 bg-[#071a34] px-4 py-3 text-white outline-none focus:border-[#e30713]"
        />
      </label>

      <label class="block lg:col-span-2">
        <span class="mb-2 block text-sm text-white/75">Titulo</span>
        <input
          type="text"
          name="title"
          required
          class="w-full rounded-2xl border border-white/10 bg-[#071a34] px-4 py-3 text-white outline-none focus:border-[#e30713]"
        />
      </label>

      <label class="block lg:col-span-2">
        <span class="mb-2 block text-sm text-white/75">Texto / resumen largo</span>
        <textarea name="body" rows="8" required class="w-full rounded-2xl border border-white/10 bg-[#071a34] px-4 py-3 text-white outline-none focus:border-[#e30713]" />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm text-white/75">Fecha en linea (texto libre)</span>
        <input
          type="text"
          name="dateLine"
          required
          placeholder="23 Marzo, 2026."
          class="w-full rounded-2xl border border-white/10 bg-[#071a34] px-4 py-3 text-white outline-none focus:border-[#e30713]"
        />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm text-white/75">Estado</span>
        <select name="status" class="w-full rounded-2xl border border-white/10 bg-[#071a34] px-4 py-3 text-white outline-none focus:border-[#e30713]">
          <option value="draft">Borrador</option>
          <option value="published">Publicado</option>
        </select>
      </label>

      <label class="block lg:col-span-2">
        <span class="mb-2 block text-sm text-white/75">Imagen (horizontal recomendada, max. 6 MB)</span>
        <input
          type="file"
          id="flashImageInput"
          accept="image/*"
          class="block w-full rounded-2xl border border-white/10 bg-[#071a34] px-4 py-3 text-sm text-white/80 file:mr-4 file:rounded-full file:border-0 file:bg-red-brand file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white"
        />
        <p class="mt-2 text-xs text-white/50">Se sube directo al almacenamiento.</p>
        <p id="flash-upload-status" class="mt-2 hidden text-xs text-white/70"></p>
      </label>

      <div class="flex justify-end lg:col-span-2">
        <button type="submit" class="btn-brand px-6 py-3">
          Guardar diapositiva
        </button>
      </div>
    </form>
  </section>
</AdminLayout>

<script>
  import { bindDirectFileInput } from "../../../scripts/direct-upload";

  const fileInput = document.getElementById("flashImageInput");
  const urlInput = document.getElementById("flashExistingImageUrl");
  const pathInput = document.getElementById("flashExistingImagePath");
  const obsoleteInput = document.getElementById("flashObsoleteImagePath");
  const statusEl = document.getElementById("flash-upload-status");

  if (
    fileInput instanceof HTMLInputElement &&
    urlInput instanceof HTMLInputElement &&
    pathInput instanceof HTMLInputElement
  ) {
    bindDirectFileInput({
      purpose: "flash",
      fileInput,
      urlInput,
      pathInput,
      obsoleteInput: obsoleteInput instanceof HTMLInputElement ? obsoleteInput : null,
      statusEl: statusEl instanceof HTMLElement ? statusEl : null,
      requiredWhenEmpty: true,
    });
  }
</script>
