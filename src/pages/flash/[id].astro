---
import Layout from '../../layouts/Layout.astro';
import { COVER_ARTICLE_FRAME, COVER_IMG_BLUR_CLASS, COVER_IMG_CLASS } from '../../lib/cover-frames';
import Header from '../../components/header.astro';
import AdSlot from '../../components/AdSlot.astro';
import Footer from '../../components/footer.astro';
import {
  flashArticleHref,
  getFlashCarouselSlides,
  getResolvedAdSlots,
  type FlashCarouselSlide,
} from '../../lib/site-content';
import { getPublishedFlashSlideById } from '../../lib/server/site-cms';
import { isPosterImage, videoMimeTypeFromUrl } from '../../lib/news-video';
import { isSupabaseConfigured } from '../../lib/server/supabase';
import { newsArticleJsonLd } from '../../lib/seo-jsonld';
import { resolveSiteUrl, absoluteSiteUrl } from '../../lib/site-url';
import { getLikeCount } from '../../lib/server/news-likes';

export const prerender = false;

const id = Astro.params.id;

if (!id) {
  return Astro.redirect('/');
}

if (!isSupabaseConfigured()) {
  return Astro.redirect('/');
}

const slide = await getPublishedFlashSlideById(id);

if (!slide || (!slide.image_url && !slide.video_url)) {
  return Astro.redirect('/');
}

const adSlots = await getResolvedAdSlots();
const allFlash = await getFlashCarouselSlides();
const relatedFlash = allFlash.filter((item) => item.id !== id).slice(0, 4);
const moreFlash = allFlash.filter((item) => item.id !== id).slice(0, 6);

function splitBody(body: string): string[] {
  const paragraphs = body
    .replace(/\r\n/g, '\n')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

  return paragraphs.length > 0 ? paragraphs : [body.trim() || 'Sin contenido adicional.'];
}

const paragraphs = splitBody(slide.body);
const articleSummary = paragraphs[0] ?? slide.title;
const coverImage = slide.image_url || '/favicon.png';
const isVideoSlide = slide.cover_media_type === 'video' && Boolean(slide.video_url);
const slideVideoUrl = slide.video_url ?? '';
const slideVideoMime = slideVideoUrl ? videoMimeTypeFromUrl(slideVideoUrl) : 'video/mp4';
const videoPoster = slide.image_url && isPosterImage(slide.image_url) ? slide.image_url : undefined;
const canonical = flashArticleHref(slide.id);
const site = resolveSiteUrl(Astro.site, import.meta.env.PUBLIC_SITE_URL);
const shareUrl = absoluteSiteUrl(site, canonical) ?? canonical;
const likeKey = `flash/${slide.id}`;
const initialLikeCount = await getLikeCount(likeKey);
const flashJsonLd = newsArticleJsonLd({
  site,
  headline: slide.title,
  description: articleSummary,
  canonicalPath: canonical,
  image: coverImage,
  datePublished: slide.created_at,
  dateModified: slide.updated_at ?? slide.created_at,
});
---

<Layout
  title={`${slide.title} | Radio News Online`}
  description={articleSummary}
  canonical={canonical}
  image={coverImage}
  type="article"
  jsonLd={flashJsonLd}
>
  <div class="min-h-screen flex flex-col overflow-x-hidden text-white" style="background-color: #041d3d;">
    <Header />

    <main class="flex-1">
      <section class="max-w-7xl mx-auto px-4 md:px-6 pt-10 pb-8">
        <nav class="flex flex-wrap items-center gap-2 text-[11px] uppercase tracking-[0.18em] text-white/85">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <span>/</span>
          <span class="text-white/70">{slide.category}</span>
          <span>/</span>
          <span class="text-white">{slide.title}</span>
        </nav>

        <div class="mt-6 grid gap-8 xl:grid-cols-[minmax(0,1fr)_320px]">
          <article class="overflow-hidden rounded-[28px] bg-[#f2f2f2] text-[#1a2332] shadow-[0_30px_60px_rgba(0,0,0,0.22)]">
            {isVideoSlide ? (
              <>
                <div class="bg-black">
                  <video
                    id="flash-cover-video"
                    class="w-full aspect-video max-h-[min(72vh,720px)] bg-black"
                    controls
                    playsinline
                    preload="metadata"
                    poster={videoPoster}
                  >
                    <source src={slideVideoUrl} type={slideVideoMime} />
                  </video>
                  <p id="flash-video-error" class="hidden px-6 py-4 text-center text-sm text-red-200">
                    No se pudo reproducir el video. Si es un archivo MOV de iPhone, exportalo como MP4 (H.264) y vuelve a subirlo.
                  </p>
                </div>
                <div class="bg-[#041d3d] px-6 py-8 md:px-10">
                  <div class="flex flex-wrap items-center gap-3 text-[11px] uppercase tracking-[0.2em]">
                    <span class="tag-brand rounded-full px-4 py-1.5 font-semibold">{slide.category}</span>
                    <span class="text-white/65">{slide.date_line}</span>
                    <span class="rounded-full border border-white/20 px-3 py-1 text-white/80">Video</span>
                  </div>
                  <h1 class="mt-5 max-w-4xl font-newsreader text-4xl leading-tight text-white md:text-5xl">
                    {slide.title}
                  </h1>
                  <p class="mt-4 max-w-3xl text-base leading-7 text-white/82 md:text-lg line-clamp-3">
                    {articleSummary}
                  </p>
                </div>
              </>
            ) : (
              <>
                <div class={COVER_ARTICLE_FRAME}>
                  <img src={coverImage} alt="" aria-hidden="true" class={COVER_IMG_BLUR_CLASS} />
                  <img
                    src={coverImage}
                    alt={slide.title}
                    class={COVER_IMG_CLASS}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#041d3d] via-[#041d3d]/45 to-transparent pointer-events-none"></div>
                  <div class="absolute inset-x-0 bottom-0 hidden pointer-events-none md:block md:p-8">
                    <div class="flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.2em]">
                      <span class="tag-brand rounded-full px-3 py-1 font-semibold">{slide.category}</span>
                      <span class="text-white/65">{slide.date_line}</span>
                    </div>

                    <h1 class="mt-3 max-w-2xl font-newsreader text-2xl leading-tight text-white md:text-3xl lg:text-4xl">
                      {slide.title}
                    </h1>

                    <p class="mt-2 max-w-xl text-sm leading-6 text-white/82 md:text-base line-clamp-3">
                      {articleSummary}
                    </p>
                  </div>
                </div>

                <div class="bg-[#041d3d] px-6 py-6 md:hidden">
                  <div class="flex flex-wrap items-center gap-3 text-[11px] uppercase tracking-[0.2em]">
                    <span class="tag-brand rounded-full px-4 py-1.5 font-semibold">{slide.category}</span>
                    <span class="text-white/65">{slide.date_line}</span>
                  </div>

                  <h1 class="mt-4 font-newsreader text-3xl leading-tight text-white">
                    {slide.title}
                  </h1>

                  <p class="mt-3 text-base leading-7 text-white/82 line-clamp-3">
                    {articleSummary}
                  </p>
                </div>
              </>
            )}

            <div class="grid gap-8 px-6 py-8 md:px-10 md:py-10 lg:grid-cols-[minmax(0,1fr)_250px]">
              <div>
                <div class="flex flex-wrap items-center gap-4 border-b border-slate-200 pb-5 text-sm text-slate-500">
                  <span class="font-semibold text-[#e30713]">Redaccion Radio News Online</span>
                  <span>{slide.date_line}</span>
                  <a href="/#flash-informativo" class="rounded-full border border-[#e30713]/25 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#e30713] transition-colors hover:bg-[#e30713] hover:text-white">
                    Volver al inicio
                  </a>
                </div>

                <div
                  class="flex flex-wrap items-center gap-3 border-b border-slate-200 py-5"
                  data-like-key={likeKey}
                  data-share-url={shareUrl}
                  data-share-title={slide.title}
                  data-share-text={articleSummary}
                >
                  <button
                    type="button"
                    id="like-button"
                    class="like-button flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-[#e30713] hover:text-[#e30713]"
                    aria-pressed="false"
                  >
                    <span class="like-icon text-lg leading-none">🤍</span>
                    <span>Me gusta</span>
                    <span id="like-count" class="tabular-nums text-slate-500">{initialLikeCount}</span>
                  </button>

                  <button
                    type="button"
                    id="share-button"
                    class="flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-[#e30713] hover:text-[#e30713]"
                  >
                    <span class="text-lg leading-none">↗</span>
                    <span id="share-label">Compartir</span>
                  </button>
                </div>

                <div class="article-copy mt-8 space-y-6 font-newsreader text-[19px] leading-9 text-slate-700">
                  {paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                <div class="mt-10">
                  <AdSlot ad={adSlots.articleInline} variant="card" className="border-slate-200 bg-slate-50" />
                </div>
              </div>
            </div>
          </article>

          <aside class="h-fit rounded-[28px] border border-white/10 bg-white/5 p-5 backdrop-blur-sm xl:sticky xl:top-28">
            <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-4">
              <div>
                <span class="text-[11px] uppercase tracking-[0.2em] text-white/85">Flash informativo</span>
                <h2 class="mt-2 font-newsreader text-2xl text-white">Mas del flash</h2>
              </div>
              <span class="tag-brand rounded-full px-3 py-1 text-[8px] uppercase tracking-[0.18em] w-fit">
                Relacionadas
              </span>
            </div>

            <div class="mt-5 space-y-4">
              {relatedFlash.length > 0 ? (
                relatedFlash.map((item: FlashCarouselSlide) => {
                  const showVideo =
                    item.coverMediaType === 'video' && Boolean(item.videoUrl) && !isPosterImage(item.imagenUrl);
                  return (
                  <a
                    href={item.href}
                    class="group flex gap-3 rounded-[22px] border border-white/8 bg-[#06172f] p-3 transition-colors hover:bg-[#0a2143]"
                  >
                    {showVideo && item.videoUrl ? (
                      <video
                        src={item.videoUrl}
                        muted
                        playsinline
                        preload="metadata"
                        class="h-20 w-24 shrink-0 rounded-2xl bg-[#041d3d] object-contain"
                        aria-label={item.titulo}
                      />
                    ) : (
                      <div class="relative h-20 w-24 shrink-0 overflow-hidden rounded-2xl bg-[#041d3d]">
                        <img src={item.imagenUrl} alt="" aria-hidden="true" class={COVER_IMG_BLUR_CLASS} />
                        <img src={item.imagenUrl} alt={item.imagenAlt} class={COVER_IMG_CLASS} />
                      </div>
                    )}
                    <div class="min-w-0">
                      <span class="text-[10px] uppercase tracking-[0.16em] text-white/90">{item.categoria}</span>
                      <h3 class="mt-2 font-newsreader text-lg leading-6 text-white transition-colors group-hover:text-[#ffd2d2]">
                        {item.titulo}
                      </h3>
                      <p class="mt-2 text-xs uppercase tracking-[0.14em] text-white/60">{item.fechaLinea}</p>
                    </div>
                  </a>
                  );
                })
              ) : (
                <p class="text-sm text-white/60">No hay mas notas publicadas en el flash.</p>
              )}
            </div>

            <div class="mt-5">
              <AdSlot ad={adSlots.articleSidebar} variant="sidebar" />
            </div>
          </aside>
        </div>
      </section>

      {moreFlash.length > 0 && (
        <section class="max-w-7xl mx-auto px-4 md:px-6 pb-16">
          <div class="flex flex-col gap-3 border-b border-white/10 pb-6 md:flex-row md:items-end md:justify-between">
            <div>
              <span class="text-[11px] uppercase tracking-[0.22em] text-white/85">Flash informativo</span>
              <h2 class="mt-2 font-newsreader text-3xl text-white md:text-4xl">Tambien en el flash</h2>
            </div>
          </div>

          <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {moreFlash.map((item) => {
              const showVideo =
                item.coverMediaType === 'video' && Boolean(item.videoUrl) && !isPosterImage(item.imagenUrl);
              return (
              <a
                href={item.href}
                class="group overflow-hidden rounded-[24px] border border-white/10 bg-[#06172f] transition-transform duration-300 hover:-translate-y-1"
              >
                <div class="relative h-52 overflow-hidden bg-[#041d3d]">
                  {showVideo && item.videoUrl ? (
                    <video
                      src={item.videoUrl}
                      muted
                      playsinline
                      preload="metadata"
                      class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                      aria-label={item.titulo}
                    />
                  ) : (
                    <>
                      <img src={item.imagenUrl} alt="" aria-hidden="true" class={COVER_IMG_BLUR_CLASS} />
                      <img
                        src={item.imagenUrl}
                        alt={item.imagenAlt}
                        class={`${COVER_IMG_CLASS} transition-transform duration-500 group-hover:scale-105`}
                      />
                    </>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-[#041d3d] via-transparent to-transparent"></div>
                  <span class="tag-brand absolute left-4 top-4 rounded-full px-3 py-1 text-[10px] uppercase tracking-[0.18em]">
                    {item.categoria}
                  </span>
                </div>

                <div class="p-5">
                  <p class="text-[11px] uppercase tracking-[0.18em] text-white/70">{item.fechaLinea}</p>
                  <h3 class="mt-3 font-newsreader text-2xl leading-8 text-white transition-colors group-hover:text-[#ffd2d2]">
                    {item.titulo}
                  </h3>
                  <p class="mt-3 line-clamp-2 text-md leading-6 text-white/80">
                    {item.texto}
                  </p>
                </div>
              </a>
              );
            })}
          </div>
        </section>
      )}
    </main>

    <Footer />
  </div>
</Layout>

{isVideoSlide && (
  <script>
    const video = document.getElementById('flash-cover-video');
    const errorMessage = document.getElementById('flash-video-error');

    if (video instanceof HTMLVideoElement && errorMessage) {
      video.addEventListener('error', () => {
        errorMessage.classList.remove('hidden');
      });
    }
  </script>
)}

<script>
  const likeButton = document.getElementById('like-button');
  const likeCountEl = document.getElementById('like-count');
  const likeIconEl = likeButton?.querySelector('.like-icon');
  const shareButton = document.getElementById('share-button');
  const shareLabelEl = document.getElementById('share-label');
  const toolbar = likeButton?.closest('[data-like-key]');

  if (likeButton && likeCountEl && likeIconEl && toolbar instanceof HTMLElement) {
    const likeKey = toolbar.dataset.likeKey ?? '';
    const storageKey = `rn-like:${likeKey}`;
    let liked = window.localStorage.getItem(storageKey) === '1';
    let count = Number.parseInt(likeCountEl.textContent ?? '0', 10) || 0;
    let busy = false;

    const render = () => {
      likeIconEl.textContent = liked ? '❤️' : '🤍';
      likeCountEl.textContent = String(Math.max(count, 0));
      likeButton.setAttribute('aria-pressed', liked ? 'true' : 'false');
      likeButton.classList.toggle('text-[#e30713]', liked);
      likeButton.classList.toggle('border-[#e30713]', liked);
    };

    render();

    likeButton.addEventListener('click', async () => {
      if (busy || !likeKey) return;
      busy = true;

      const nextLiked = !liked;
      const previousCount = count;
      liked = nextLiked;
      count = nextLiked ? count + 1 : Math.max(count - 1, 0);
      render();

      try {
        const response = await fetch('/api/likes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: likeKey, liked: nextLiked }),
        });

        if (!response.ok) {
          throw new Error(`Ticker de likes respondio ${response.status}`);
        }

        const data = await response.json();
        if (typeof data.count === 'number') {
          count = data.count;
        }

        window.localStorage.setItem(storageKey, nextLiked ? '1' : '0');
      } catch (error) {
        console.error('No se pudo actualizar el me gusta.', error);
        liked = !nextLiked;
        count = previousCount;
      } finally {
        render();
        busy = false;
      }
    });
  }

  if (shareButton && shareLabelEl && toolbar instanceof HTMLElement) {
    const shareUrl = toolbar.dataset.shareUrl ?? window.location.href;
    const shareTitle = toolbar.dataset.shareTitle ?? document.title;
    const shareText = toolbar.dataset.shareText ?? '';

    shareButton.addEventListener('click', async () => {
      const nav = window.navigator;

      if (nav.share) {
        try {
          await nav.share({ title: shareTitle, text: shareText, url: shareUrl });
          return;
        } catch {
          /* el usuario cancelo el menu nativo, no hacer nada */
          return;
        }
      }

      try {
        await nav.clipboard.writeText(shareUrl);
        const original = shareLabelEl.textContent;
        shareLabelEl.textContent = '¡Enlace copiado!';
        window.setTimeout(() => {
          shareLabelEl.textContent = original;
        }, 2000);
      } catch (error) {
        console.error('No se pudo copiar el enlace.', error);
        window.prompt('Copia el enlace para compartir:', shareUrl);
      }
    });
  }
</script>

<style>
  .article-copy :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-copy :global(h2),
  .article-copy :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #1a2332;
    font-weight: 700;
    line-height: 1.2;
  }

  .article-copy :global(ul),
  .article-copy :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .article-copy :global(li) {
    margin-bottom: 0.75rem;
  }
</style>
